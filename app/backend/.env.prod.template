# ==============================
# Production - Backend settings
# File location: app/backend/.env
# ==============================

NODE_ENV=production
PORT=8787

# Frontend allowed origins (comma separated)
FRONTEND_ORIGIN=https://your-frontend-domain.com,https://www.your-frontend-domain.com
FRONTEND_PUBLIC_URL=https://your-frontend-domain.com
BACKEND_PUBLIC_URL=https://api.your-backend-domain.com

# Persistence / Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# DATABASE_SSL=false

# Fallback local file persistence (used if DATABASE_URL is empty)
DATA_FILE=data/store.json

# Security / Rate limits
AUTH_RATE_LIMIT_MAX=20
API_RATE_LIMIT_MAX=300

# Stripe (set real values in hosting environment variables)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SESSION=
STRIPE_PRICE_MONTHLY=
PAYMENT_CURRENCY=xof
PLAN_SESSION_AMOUNT=1500
PLAN_MONTHLY_AMOUNT=5000

# OpenAI
OPENAI_API_KEY=
STT_MODEL=whisper-1
LLM_MODEL=gpt-4o-mini
INTERVIEW_QUESTION_COUNT=7
